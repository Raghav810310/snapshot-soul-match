# Public browser configuration is supplied by Lovable Cloud.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Store private values in Lovable Project Settings → Secrets, never in Git.
# LOVABLE_API_KEY is managed automatically; no separate OpenAI key is required.
# Supported server-side models:
# openai/gpt-6-astra (default), openai/gpt-6.1-terra
AI_MODEL=openai/gpt-6-astra